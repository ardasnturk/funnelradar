    "Showing the %@ most recently changed of %@ saved funnels. Each one costs queries.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezeigt werden die %1$@ zuletzt geänderten von %2$@ gespeicherten Funnels. Jeder kostet Abfragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestran los %1$@ cambiados más recientemente de %2$@ embudos guardados. Cada uno cuesta consultas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichage des %1$@ entonnoirs modifiés le plus récemment sur %2$@ enregistrés. Chacun coûte des requêtes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono mostrati i %1$@ modificati più di recente su %2$@ funnel salvati. Ognuno costa query."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの%2$@個のファネルのうち、最近変更された%1$@個を表示しています。1つごとにクエリを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 퍼널 %2$@개 중 가장 최근에 바뀐 %1$@개를 표시합니다. 각각 쿼리를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando os %1$@ alterados mais recentemente entre %2$@ funis salvos. Cada um custa consultas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı %2$@ hunin en son değişen %1$@ tanesi gösteriliyor. Her biri sorgu harcar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示已保存的 %2$@ 个漏斗中最近更改的 %1$@ 个。每个都会消耗查询。"
          }
        }
      }
    },
