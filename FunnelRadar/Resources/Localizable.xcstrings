            "state": "translated",
            "value": "提醒内容"
          }
        }
      }
    },
    "The event lists appear after FunnelRadar's first read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ereignislisten erscheinen nach dem ersten Lesen durch FunnelRadar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las listas de eventos aparecen tras la primera lectura de FunnelRadar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les listes d'événements apparaissent après la première lecture de FunnelRadar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elenchi degli eventi compaiono dopo la prima lettura di FunnelRadar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントの一覧は、FunnelRadarの最初の読み取り後に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트 목록은 FunnelRadar의 첫 읽기 후에 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
