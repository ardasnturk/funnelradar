    "Only reads. It sends nothing anywhere except your queries to Mixpanel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest nur. Es sendet nichts irgendwohin, außer deinen Abfragen an Mixpanel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lee. No envía nada a ningún sitio salvo tus consultas a Mixpanel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture seule. Il n'envoie rien nulle part, sauf vos requêtes à Mixpanel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge soltanto. Non invia nulla da nessuna parte, tranne le tue query a Mixpanel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用です。Mixpanelへのクエリ以外は、どこにも何も送信しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기만 합니다. Mixpanel로 보내는 쿼리 외에는 어디에도 아무것도 보내지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só lê. Não envia nada a lugar nenhum, exceto suas consultas ao Mixpanel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca okur. Mixpanel'e giden sorgularınız dışında hiçbir yere hiçbir şey göndermez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅读取。除了发往 Mixpanel 的查询外，不会向任何地方发送任何内容。"
          }
        }
      }
    },
