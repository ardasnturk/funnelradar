    "DAU/MAU of the key event, full months only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DAU/MAU des Schlüsselereignisses, nur volle Monate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DAU/MAU del evento clave, solo meses completos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DAU/MAU de l'événement clé, mois complets uniquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DAU/MAU dell'evento chiave, solo mesi interi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーイベントのDAU/MAU（完全な月のみ）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핵심 이벤트의 DAU/MAU, 완전한 달만 포함."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "DAU/MAU do evento principal, só meses completos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana olayın DAU/MAU değeri, yalnızca tam aylar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关键事件的 DAU/MAU，仅限完整月份。"
          }
        }
      }
    },
    "DAU/MAU: the average day's users as a share of the month's.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DAU/MAU: die Nutzer eines Durchschnittstags als Anteil an denen des Monats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DAU/MAU: los usuarios de un día medio como parte de los del mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DAU/MAU : les utilisateurs d'un jour moyen en proportion de ceux du mois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DAU/MAU: gli utenti di un giorno medio come quota di quelli del mese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DAU/MAU：平均的な日のユーザー数が月のユーザー数に占める割合。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DAU/MAU: 평균적인 하루의 사용자가 그달 사용자에서 차지하는 비율."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "DAU/MAU: os usuários de um dia médio como parcela dos do mês."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DAU/MAU: ortalama bir günün kullanıcılarının aydakilere oranı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DAU/MAU：平均每日用户数占当月用户数的比例。"
          }
        }
      }
    },
