            "value": "Esto se completa tras un mes completo de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela se remplit après un mois complet de données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si compila dopo un mese intero di dati."
          }
        },
        "ja": {
