    },
    "Weekly cohorts by day. Blank cells are too young to know.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wöchentliche Kohorten nach Tag. Leere Zellen sind noch zu jung, um etwas zu sagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cohortes semanales por día. Las celdas vacías son demasiado recientes para saberlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cohortes hebdomadaires par jour. Les cases vides sont trop récentes pour qu'on sache."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coorti settimanali per giorno. Le celle vuote sono troppo recenti per dirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週ごとのコホートを日別に表示します。空白のセルは、まだ新しすぎて判断できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주간 코호트를 일별로 보여 줍니다. 빈 칸은 아직 너무 최근이라 알 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coortes semanais por dia. As células em branco são recentes demais para saber."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftalık kohortlar, güne göre. Boş hücreler henüz bilinemeyecek kadar yeni."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按天显示每周同期群。空白格尚太新，还无法判断。"
          }
        }
      }
    },
