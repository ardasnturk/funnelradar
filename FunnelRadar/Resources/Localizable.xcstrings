    "Each app costs about a dozen of Mixpanel's 60 queries an hour on its first read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede App kostet beim ersten Lesen etwa ein Dutzend der 60 Abfragen pro Stunde von Mixpanel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada app cuesta unas doce de las 60 consultas por hora de Mixpanel en su primera lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque app coûte environ une douzaine des 60 requêtes par heure de Mixpanel à sa première lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni app costa circa una dozzina delle 60 query orarie di Mixpanel alla prima lettura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各アプリは最初の読み取りで、Mixpanelの1時間60クエリのうち約12クエリを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 앱은 첫 읽기에서 Mixpanel의 시간당 쿼리 60개 중 약 12개를 씁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
