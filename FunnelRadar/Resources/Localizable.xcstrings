        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : %2$@ utilisateurs, contre environ %3$@ un jour normal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ utenti, contro circa %3$@ in un giorno normale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：ユーザー%2$@人。通常の日は約%3$@人です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: 사용자 %2$@명, 평소에는 약 %3$@명입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ usuários, contra cerca de %3$@ em um dia normal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ kullanıcı, normal bir günde yaklaşık %3$@."
          }
        },
