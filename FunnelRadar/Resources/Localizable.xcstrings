{
  "sourceLanguage": "en",
  "strings": {
    "%@ is your busiest day, %@ against an average day.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist dein aktivster Tag, %2$@ gegenüber einem Durchschnittstag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ es tu día más activo, %2$@ frente a un día medio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est votre jour le plus actif, %2$@ par rapport à un jour moyen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è il tuo giorno più attivo, %2$@ rispetto a un giorno medio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も活発な曜日は%1$@で、平均的な日の%2$@です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 활발한 요일은 %1$@이며, 평균적인 날 대비 %2$@입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ é seu dia mais movimentado, %2$@ em relação a um dia médio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ en yoğun gününüz, normal bir güne göre %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 是最活跃的一天，相对平均日为 %2$@。"
          }
        }
      }
    },
    "%@ keeps %@ here": {
