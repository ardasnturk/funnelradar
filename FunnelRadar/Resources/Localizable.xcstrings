    "This project has no saved funnels. Save one in Mixpanel and it appears here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Projekt hat keine gespeicherten Funnels. Speichere einen in Mixpanel, dann erscheint er hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proyecto no tiene embudos guardados. Guarda uno en Mixpanel y aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce projet n'a aucun entonnoir enregistré. Enregistrez-en un dans Mixpanel et il apparaîtra ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
