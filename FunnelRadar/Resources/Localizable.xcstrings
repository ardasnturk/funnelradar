    "%@ loses the most people at %@: only %@ get there from %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ verliert die meisten Leute bei %2$@: Nur %3$@ kommen von %4$@ dorthin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pierde más gente en %2$@: solo %3$@ llega desde %4$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ perd le plus de monde à %2$@ : seuls %3$@ y arrivent depuis %4$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ perde più persone a %2$@: solo %3$@ ci arriva da %4$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%2$@で最も多くの人が離脱します。%4$@から到達するのは%3$@だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) %2$@에서 가장 많은 사람이 이탈합니다. %4$@에서 넘어오는 사람은 %3$@뿐입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ perde mais gente em %2$@: só %3$@ chega lá a partir de %4$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ en çok insanı %2$@ adımında kaybediyor: %4$@ adımından oraya yalnızca %3$@ ulaşıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在 %2$@ 流失的人最多：从 %4$@ 到达这里的只有 %3$@。"
          }
        }
      }
    },
