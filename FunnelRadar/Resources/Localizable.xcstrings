            "value": "デイリーユーザー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일일 사용자"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuários diários"
          }
        },
