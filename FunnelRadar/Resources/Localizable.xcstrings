    "In %@ an active user came back on about %@ days of 30.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$@ kam ein aktiver Nutzer an etwa %2$@ von 30 Tagen zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %1$@ un usuario activo volvió en unos %2$@ de 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En %1$@, un utilisateur actif est revenu environ %2$@ jours sur 30."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$@ un utente attivo è tornato in circa %2$@ giorni su 30."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@には、アクティブユーザーは30日のうち約%2$@日戻ってきました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에는 활성 사용자가 30일 중 약 %2$@일 돌아왔습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em %1$@, um usuário ativo voltou em cerca de %2$@ dos 30 dias."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ içinde aktif bir kullanıcı 30 günün yaklaşık %2$@ gününde geri geldi."
