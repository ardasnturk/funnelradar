    "Mixpanel allows a project 60 queries an hour, shared with its other tools. A check costs one query per app; the full reports are read once a day, about a dozen queries per app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixpanel erlaubt einem Projekt 60 Abfragen pro Stunde, geteilt mit seinen anderen Tools. Eine Prüfung kostet eine Abfrage pro App; die vollständigen Berichte werden einmal täglich gelesen, etwa ein Dutzend Abfragen pro App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixpanel permite 60 consultas por hora a un proyecto, compartidas con sus otras herramientas. Una comprobación cuesta una consulta por app; los informes completos se leen una vez al día, unas doce consultas por app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixpanel autorise 60 requêtes par heure à un projet, partagées avec ses autres outils. Une vérification coûte une requête par app ; les rapports complets sont lus une fois par jour, environ une douzaine de requêtes par app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixpanel concede 60 query all'ora a un progetto, condivise con i suoi altri strumenti. Un controllo costa una query per app; i report completi si leggono una volta al giorno, circa una dozzina di query per app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixpanelは1プロジェクトあたり1時間に60クエリまで許可し、他のツールと共有されます。チェックはアプリごとに1クエリ、完全なレポートは1日1回の読み取りでアプリごとに約12クエリです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixpanel은 프로젝트당 시간당 쿼리 60개를 허용하며, 다른 도구와 공유됩니다. 확인은 앱당 쿼리 1개이고, 전체 보고서는 하루에 한 번 읽으며 앱당 약 12개가 듭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mixpanel permite 60 consultas por hora a um projeto, compartilhadas com suas outras ferramentas. Uma verificação custa uma consulta por app; os relatórios completos são lidos uma vez por dia, cerca de uma dúzia de consultas por app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixpanel bir projeye saatte 60 sorguya izin verir ve bunlar diğer araçlarıyla paylaşılır. Bir kontrol uygulama başına bir sorgu harcar; tam raporlar günde bir kez okunur, uygulama başına yaklaşık on iki sorgu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixpanel 允许每个项目每小时 60 次查询，并与其他工具共用。一次检查每个应用消耗一次查询；完整报告每天读取一次，每个应用约十来次查询。"
          }
        }
      }
    },
    "Mixpanel asked FunnelRadar to slow down. It will try again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixpanel hat FunnelRadar gebeten, langsamer zu machen. Es versucht es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixpanel pidió a FunnelRadar que fuera más despacio. Lo intentará de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixpanel a demandé à FunnelRadar de ralentir. Il réessaiera plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixpanel ha chiesto a FunnelRadar di rallentare. Riproverà più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MixpanelからFunnelRadarに、速度を落とすよう求められました。後でもう一度試します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixpanel이 FunnelRadar에 속도를 늦추라고 요청했습니다. 나중에 다시 시도합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mixpanel pediu ao FunnelRadar que diminuísse o ritmo. Ele tentará de novo mais tarde."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixpanel, FunnelRadar'dan yavaşlamasını istedi. Daha sonra yeniden denenecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixpanel 要求 FunnelRadar 放慢速度。稍后会重试。"
          }
        }
      }
    },
    "Mixpanel didn't accept this service account.": {
